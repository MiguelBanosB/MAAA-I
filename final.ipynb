      "Seleccionadas 57 columnas (10%) según |Pearson|:\n",
      "[\"tBodyAcc-std()-X\", \"tBodyAcc-max()-X\", \"tBodyAcc-mad()-X\", \"fBodyAcc-mad()-X\", \"fBodyAcc-mean()-X\", \"tGravityAccMag-mean()\", \"tBodyAccMag-mean()\", \"tGravityAccMag-sma()\", \"tBodyAccMag-sma()\", \"fBodyAccMag-mad()\", \"tBodyAcc-sma()\", \"fBodyAcc-max()-X\", \"tGravityAccMag-max()\", \"tBodyAccMag-std()\", \"fBodyAccMag-mean()\", \"fBodyAccMag-sma()\", \"fBodyAcc-sma()\", \"tGravityAccMag-mad()\", \"tBodyAccMag-mad()\", \"fBodyAccMag-std()\", \"fBodyAcc-entropy()-X\", \"fBodyAccJerk-entropy()-X\", \"fBodyAccMag-iqr()\", \"tBodyAcc-iqr()-X\", \"fBodyBodyAccJerkMag-entropy()\", \"tBodyAccJerk-std()-X\", \"tBodyAccJerk-mad()-X\", \"tBodyAcc-min()-X\", \"fBodyAccJerk-mad()-X\", \"fBodyAccJerk-std()-X\", \"tGravityAccMag-energy()\", \"tBodyAccMag-energy()\", \"fBodyAccJerk-sma()\", \"fBodyBodyAccJerkMag-sma()\", \"fBodyBodyAccJerkMag-mean()\", \"fBodyAccMag-entropy()\", \"fBodyAccJerk-entropy()-Z\", \"tBodyAccJerk-iqr()-X\", \"tBodyAccJerkMag-sma()\", \"tBodyAccJerkMag-mean()\", \"tBodyAccJerk-sma()\", \"tBodyAccJerkMag-mad()\", \"tBodyAccJerkMag-std()\", \"fBodyAccJerk-entropy()-Y\", \"fBodyAccJerk-iqr()-X\", \"fBodyBodyAccJerkMag-iqr()\", \"fBodyBodyAccJerkMag-mad()\", \"tBodyAccJerkMag-entropy()\", \"fBodyAcc-iqr()-X\", \"tGravityAccMag-iqr()\", \"tBodyAccMag-iqr()\", \"tBodyGyroMag-sma()\", \"tBodyGyroMag-mean()\", \"tBodyGyro-sma()\", \"fBodyAccJerk-max()-X\", \"tBodyAccJerkMag-max()\", \"tBodyAccJerkMag-iqr()\"]\n"
     ]
    }
